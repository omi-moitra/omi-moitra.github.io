# Public Vite configuration only. Values prefixed with VITE_ are embedded in the
# browser bundle; never place a service-role key, password, or session token here.
# The anonymous/publishable key relies on the RLS policies in supabase/messages.sql.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key
